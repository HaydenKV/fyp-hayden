Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Show Axes: true
      Show Names: false
      Alpha: 0.5

    - Class: rviz/LaserScan
      Name: Scan
      Enabled: true
      Topic: /scan
      Queue Size: 10
      Style: Flat Squares
      Size (m): 0.03
      Axis: Z
      Color Transformer: Intensity
      Use Rainbow: true
      Autocompute Intensity Bounds: true
      Min Intensity: 0
      Max Intensity: 4096
      Decay Time: 0
      Selectable: true

    # RAW cones -> spheres
    - Class: rviz/MarkerArray
      Name: Cones (RAW)
      Enabled: true
      Marker Topic: /cones_markers_raw
      Queue Size: 10

    # TRACKED cones -> smaller spheres, different color (via the helper below)
    - Class: rviz/MarkerArray
      Name: Cones (TRACKED)
      Enabled: true
      Marker Topic: /cones_markers_tracked
      Queue Size: 10

    - Class: rviz/Grid
      Enabled: true

  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/Measure

  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: TopDown
      Target Frame: odom
      Angle: 0
      Scale: 50
      X: 0
      Y: 0
