Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views

Visualization Manager:
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30

  Displays:
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Show Axes: true
      Show Names: false
      Alpha: 0.5

    - Class: rviz/LaserScan
      Name: Scan
      Enabled: true
      Topic: /scan
      Queue Size: 10
      Style: Flat Squares
      Size (m): 0.03
      Axis: Z
      Color Transformer: Intensity
      Use Rainbow: true
      Autocompute Intensity Bounds: true
      Min Intensity: 0
      Max Intensity: 4096
      Decay Time: 0
      Selectable: true

    # RAW cones
    - Class: rviz/MarkerArray
      Name: Cones (RAW)
      Enabled: true
      Marker Topic: /cones_markers_raw
      Queue Size: 10

    # TRACKED cones (colored)
    - Class: rviz/MarkerArray
      Name: Cones (TRACKED)
      Enabled: true
      Marker Topic: /cones_markers_tracked
      Queue Size: 10

    - Class: rviz/Grid
      Enabled: true

    # === Existing combined debug image (front) ===
    - Class: rviz/Image
      Name: Cone Colour (debug)
      Enabled: true
      Image Topic: /cone_colour/debug_image
      Queue Size: 2
      Normalize Range: true
      Min Value: 0
      Max Value: 255
      Median window: 5
      Zoom Factor: 1

    # === NEW: Per-camera annotated debug feeds ===
    - Class: rviz/Image
      Name: Cone Colour (front)
      Enabled: true
      Image Topic: /cone_colour/debug_front
      Queue Size: 2
      Normalize Range: true
      Min Value: 0
      Max Value: 255
      Median window: 5
      Zoom Factor: 1

    - Class: rviz/Image
      Name: Cone Colour (left)
      Enabled: true
      Image Topic: /cone_colour/debug_left
      Queue Size: 2
      Normalize Range: true
      Min Value: 0
      Max Value: 255
      Median window: 5
      Zoom Factor: 1

    - Class: rviz/Image
      Name: Cone Colour (right)
      Enabled: true
      Image Topic: /cone_colour/debug_right
      Queue Size: 2
      Normalize Range: true
      Min Value: 0
      Max Value: 255
      Median window: 5
      Zoom Factor: 1

  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/Measure

  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: TopDown
      Target Frame: odom
      Angle: 0
      Scale: 50
      X: 0
      Y: 0
