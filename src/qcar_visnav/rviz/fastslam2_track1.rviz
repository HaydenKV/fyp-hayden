Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views

Visualization Manager:
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30

  Displays:
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Show Axes: true
      Show Names: false
      Alpha: 0.5

    - Class: rviz/LaserScan
      Name: Scan
      Enabled: true
      Topic: /scan
      Queue Size: 10
      Style: Flat Squares
      Size (m): 0.03
      Axis: Z
      Color Transformer: Intensity
      Use Rainbow: true
      Autocompute Intensity Bounds: true
      Min Intensity: 0
      Max Intensity: 4096
      Decay Time: 0
      Selectable: true

    # RAW cones (explicit)
    - Class: rviz/MarkerArray
      Name: Cones (RAW)
      Enabled: true
      Marker Topic: /cones_markers_raw
      Queue Size: 10

    # TRACKED cones (explicit)
    - Class: rviz/MarkerArray
      Name: Cones (TRACKED)
      Enabled: true
      Marker Topic: /cones_markers_tracked
      Queue Size: 10

    # SLAM particles (PoseArray — spread)
    - Class: rviz/PoseArray
      Name: SLAM Particle Poses
      Enabled: true
      Topic: /slam/particles_pose
      Queue Size: 10
      Color: 255; 0; 0
      Arrow Length: 0.3

    # --- SLAM layers (single topic; filter by namespace) ---
    - Class: rviz/MarkerArray
      Name: SLAM Landmarks (ALL)
      Enabled: true
      Marker Topic: /slam/map_markers
      Queue Size: 10
      Namespaces:
        landmarks_all: true
        landmarks_confirmed: false
        landmarks_locked: false
        landmarks_unmatched: false

    - Class: rviz/MarkerArray
      Name: SLAM Landmarks (CONFIRMED)
      Enabled: true
      Marker Topic: /slam/map_markers
      Queue Size: 10
      Namespaces:
        landmarks_all: false
        landmarks_confirmed: true
        landmarks_locked: false
        landmarks_unmatched: false

    - Class: rviz/MarkerArray
      Name: SLAM Landmarks (LOCKED)
      Enabled: true
      Marker Topic: /slam/map_markers
      Queue Size: 10
      Namespaces:
        landmarks_all: false
        landmarks_confirmed: false
        landmarks_locked: true
        landmarks_unmatched: false

    - Class: rviz/MarkerArray
      Name: SLAM Landmarks (UNMATCHED)
      Enabled: true
      Marker Topic: /slam/map_markers
      Queue Size: 10
      Namespaces:
        landmarks_all: false
        landmarks_confirmed: false
        landmarks_locked: false
        landmarks_unmatched: true

    # SLAM odometry
    - Class: rviz/Odometry
      Name: SLAM Odom (best)
      Enabled: true
      Topic: /slam/odom
      Shape: Arrow
      Length: 0.4
      Color: 0; 255; 0
      Alpha: 0.5

    - Class: rviz/Odometry
      Name: SLAM Odom (mean)
      Enabled: false
      Topic: /slam/odom_mean
      Shape: Arrow
      Length: 0.4
      Color: 255; 0; 0
      Alpha: 1.0

    - Class: rviz/Grid
      Enabled: true
      Cell Size: 1.0
      Color: 160; 160; 160
      Alpha: 0.5

  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: TopDown
      Target Frame: odom
      Angle: 0
      Scale: 80
      X: 0
      Y: 0

  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/Measure
