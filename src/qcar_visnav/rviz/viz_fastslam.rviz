# ============================================
# FastSLAM 2.0 Configuration - FIXED VERSION
# ============================================

# Core algorithm parameters - TUNED for better performance
particles: 80                    # Reduced for debugging, increase to 120 when working
resample_neff_ratio: 0.7         # More conservative resampling
chi2_gate: 7.38                  # Tighter gating (97.5% confidence, reduced from 99%)
new_landmark_likelihood_min: 0.4  # Higher threshold to reduce spurious landmarks

# Measurement noise (cartesian projection) - REDUCED for better convergence
meas_noise_xy_x: 0.15            # Reduced from 0.25
meas_noise_xy_y: 0.15            # Reduced from 0.25

# Motion noise - PROPERLY SCALED
odom_v_std: 0.12                 # Slightly reduced for stability
odom_yawrate_std: 0.15           # Reduced angular noise

# Frame definitions
map_frame:   "map"
odom_frame:  "odom"
base_frame:  "base_footprint"
lidar_frame: "lidar"

# LiDAR->base extrinsics (CRITICAL - VERIFY THESE!)
lidar_to_base_x: 0.0             # CHECK: LiDAR position relative to base_footprint
lidar_to_base_y: 0.0             # CHECK: Usually LiDAR is slightly forward/up
lidar_to_base_yaw_deg: 0.0       # CHECK: LiDAR orientation relative to robot

# Topic names
tracked_topic: "/tracked_cones"
odom_topic:    "/ekf/odom"

# Publication topics
pub_particles:     "/slam/particles"
pub_landmarks:     "/map_markers"
pub_weights:       "/slam/weights"
pub_slam_odom:     "/slam/odom"

# Penalty factors - TUNED for robustness
miss_in_fov_penalty: 0.7         # Increased penalty
color_mismatch_penalty: 0.8      # Increased penalty

# DEBUG MODE - set to true for validation with ground truth
debug_use_ground_truth: false    # Set to true for debugging

# Advanced parameters for pose refinement
pose_refinement_enabled: true     # Enable FastSLAM 2.0 pose refinement
max_pose_correction_m: 0.5       # Maximum pose correction per step
pose_correction_weight: 0.3      # How aggressively to apply corrections

# Data association parameters
max_association_distance_m: 1.0  # Maximum distance for landmark association
min_correspondences_for_refinement: 2  # Minimum matches needed for pose refinement