Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Show Axes: true
      Show Names: true
      Alpha: 0.5

    - Class: rviz/LaserScan
      Name: Scan
      Enabled: true
      Topic: /scan
      Queue Size: 10
      Style: Flat Squares
      Size (m): 0.03
      Color Transformer: Intensity
      Use Rainbow: true

    - Class: rviz/MarkerArray
      Name: Raw Cones
      Enabled: true
      Marker Topic: /cones_markers_raw
      Queue Size: 10

    - Class: rviz/MarkerArray
      Name: Tracked Cones
      Enabled: true
      Marker Topic: /cones_markers_tracked
      Queue Size: 10

    - Class: rviz/MarkerArray
      Name: SLAM Landmarks
      Enabled: true
      Marker Topic: /map_markers
      Queue Size: 10

    - Class: rviz/PoseArray
      Name: Particles
      Enabled: true
      Topic: /slam/particles
      Queue Size: 5
      Color: 255; 25; 0
      Alpha: 0.7
      Shaft Length: 0.3
      Shaft Radius: 0.02
      Head Length: 0.1
      Head Radius: 0.05

    - Class: rviz/Odometry
      Name: SLAM Pose
      Enabled: true
      Topic: /slam/odom
      Keep: 50
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape:
        Alpha: 1
        Axes Length: 0.5
        Axes Radius: 0.05
        Color: 0; 255; 0
        Head Length: 0.3
        Head Radius: 0.1
        Shaft Length: 1
        Shaft Radius: 0.05
        Value: Arrow
      Covariance:
        Enabled: true
        Color: 255; 255; 127
        Alpha: 0.3

    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Color: 160; 160; 164
      Alpha: 0.5

  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select

  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: TopDown
      Target Frame: map
      Angle: 0
      Scale: 25
      X: 0
      Y: 0