<launch>
  <!-- Velocity-based EKF Launch File -->
  
  <!-- Load EKF configuration -->
  <rosparam file="$(find qcar_visnav)/config/ekf.yaml" command="load"/>

  <!-- Start the velocity EKF node -->
  <node pkg="qcar_visnav"
        type="ekf_node"
        name="velocity_ekf"
        output="screen">

    <!-- Remap topics if needed -->
    <remap from="/joint_states" to="/qcar/joint_states"/>
    
    <!-- Optional: remap IMU topic if different -->
    <!-- <remap from="/imu" to="/qcar/imu/data"/> -->
    
    <!-- Optional: remap steering topic if available -->
    <!-- <remap from="/steering/angle" to="/qcar/steering/angle"/> -->

  </node>

  <!-- Optional: Publish static transform for visualization -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_imu"
        args="0 0 0.16 0 0 0 base_link imu_link" />

</launch>