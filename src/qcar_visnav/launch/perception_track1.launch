<launch>
  <!-- Use Gazebo sim time -->
  <param name="use_sim_time" value="true"/>

  <!-- 1) Bring up Track 1 + EKF -->
  <include file="$(find qcar_visnav)/launch/Track1ExampleEKF.launch"/>

  <!-- 2) Load perception params -->
  <rosparam file="$(find qcar_visnav)/config/perception.yaml" command="load"/>

  <!-- 3) Cone detector (clustering path active via YAML) -->
  <node pkg="qcar_visnav" type="cone_detector_node" name="cone_detector" output="screen"/>

  <!-- RViz with our config -->
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find qcar_visnav)/rviz/perception_track1.rviz"/>

  <!-- 4) Cones marker node (this package!) -->
  <node pkg="qcar_visnav" type="cones_viz_node" name="cone_markers" output="screen">
    <param name="cones_topic"   value="/cones"/>
    <param name="markers_topic" value="/cones_markers"/>
    <!-- NOTE: parameter name is sphere_diam (not sphere_diameter) -->
    <param name="sphere_diam"   value="0.22"/>
    <param name="text_scale"    value="0.18"/>
    <param name="lifetime"      value="0.0"/>   <!-- keep forever while debugging -->
    <param name="show_text"     value="true"/>
  </node>
</launch>
