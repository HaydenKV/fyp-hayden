<launch>
  <param name="use_sim_time" value="true"/>

  <include file="$(find qcar_visnav)/launch/Track1ExampleEKF.launch"/>

  <rosparam file="$(find qcar_visnav)/config/perception.yaml" command="load"/>

  <!-- Detector -->
  <node pkg="qcar_visnav" type="cone_detector_node" name="cone_detector" output="screen">
    <!-- If your TF tree uses 'lidar_link', set it here; otherwise leave as your default -->
    <!-- <param name="lidar_frame" value="lidar_link"/> -->
  </node>

  <!-- Tracker -->
  <node pkg="qcar_visnav" type="cone_tracker_node" name="cone_tracker" output="screen">
    <param name="detections_topic" value="/cones"/>
    <param name="tracks_topic"     value="/tracked_cones"/>
    <param name="odom_frame" value="odom"/>
    <param name="base_frame" value="base_footprint"/>
    <param name="gate_chi2" value="5.99"/>
    <param name="init_hits" value="2"/>
    <param name="max_misses" value="5"/>
    <param name="init_cov"   value="0.25"/>
    <param name="q_xy"       value="0.01"/>
    <param name="r_scale"    value="1.0"/>
    <param name="tf_use_latest" value="true"/> <!-- fallback while validating -->
    <param name="debug"      value="1"/>
  </node>

  <!-- RViz -->
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find qcar_visnav)/rviz/perception_track1.rviz"/>

  <!-- Raw and tracked markers (compare side-by-side) -->
  <node pkg="qcar_visnav" type="cones_viz_node" name="cone_markers_raw" output="screen">
    <param name="cones_topic"   value="/cones"/>
    <param name="markers_topic" value="/cones_markers_raw"/>
    <param name="sphere_diam"   value="0.22"/>
    <param name="text_scale"    value="0.18"/>
    <param name="lifetime"      value="0.0"/>
    <param name="show_text"     value="true"/>
  </node>

  <node pkg="qcar_visnav" type="cones_viz_node" name="cone_markers_tracked" output="screen">
    <param name="cones_topic"   value="/tracked_cones"/>
    <param name="markers_topic" value="/cones_markers_tracked"/>
    <param name="sphere_diam"   value="0.22"/>
    <param name="text_scale"    value="0.18"/>
    <param name="lifetime"      value="0.0"/>
    <param name="show_text"     value="true"/>
  </node>

  <!-- Static TF (remove if your URDF already provides base_footprint->lidar) -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="lidar_to_base"
        args="0 0 0 0 0 0 base_footprint lidar"/>
</launch>
