<launch>
  <!-- Use simulation clock -->
  <param name="use_sim_time" value="true"/>

  <!-- Sim + EKF -->
  <include file="$(find qcar_visnav)/launch/Track1ExampleEKF.launch"/>

  <!-- Perception params -->
  <rosparam file="$(find qcar_visnav)/config/perception.yaml" command="load"/>

  <!-- Detector -->
  <node pkg="qcar_visnav" type="cone_detector_node" name="cone_detector" output="screen"/>

  <!-- Tracker -->
  <node pkg="qcar_visnav" type="cone_tracker_node" name="cone_tracker" output="screen"/>

  <!-- Colour: keep visualization behaviour identical, just swap to CSI inputs via YAML -->
  <!-- IMPORTANT: Use the actual installed binary name here. 
       If your CMake builds 'cone_colour_node', keep it like this.
       If it builds 'cone_colour', change type to 'cone_colour'. -->
  <node pkg="qcar_visnav" type="cone_colour_node" name="cone_colour" output="screen"/>

  <!-- Visualize cones (unchanged) -->
  <node pkg="qcar_visnav" type="cones_viz_node" name="cones_viz" output="screen">
    <param name="raw_cones_topic"       value="/cones"/>
    <param name="markers_topic_raw"     value="/cones_markers_raw"/>

    <!-- TRACKED layer (use the colored topic) -->
    <param name="tracked_cones_topic"   value="/cones_colored"/>
    <param name="markers_topic_tracked" value="/cones_markers_tracked"/>

    <param name="label_mode"            value="id"/>
    <param name="use_latest_tf"         value="true"/>
    <param name="z_offset_tracked"      value="0.10"/>
  </node>

  <!-- RViz (loads our config which already shows the debug image) -->
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find qcar_visnav)/rviz/perception_track1.rviz"/>
</launch>
