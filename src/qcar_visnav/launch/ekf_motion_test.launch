<launch>
  <!-- Complete EKF Test with Automatic Motion Commands -->
  
  <!-- Set initial robot pose -->
  <arg name="x" default="-4.3"/>
  <arg name="y" default="3"/>
  <arg name="z" default="0"/>
  <arg name="roll" default="0"/>
  <arg name="pitch" default="0"/>
  <arg name="yaw" default="-3.14"/>

  <!-- Robot setup -->
  <param name="robot_description" command="$(find xacro)/xacro $(find qcar_gazebo)/urdf/qcar_model.xacro" />
  <rosparam file="$(find qcar_controlplugin)/config/qcar_controlplugin.yaml" command="load"/>
  
  <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher"/>
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
    <remap from="/joint_states" to="/qcar/joint_states" />
  </node>
  
  <!-- Gazebo -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">     
    <arg name="world_name" value="$(find qcar_gazebo)/worlds/Track1.world"/>     
    <arg name="gui" value="true"/> 
    <arg name="verbose" value="false" />  
  </include> 
  
  <node name="spawn_qcar" pkg="gazebo_ros" type="spawn_model" output="screen" 
    args="-urdf -param robot_description -model qcar -x $(arg x) -y $(arg y) -z $(arg z) -R $(arg roll) -P $(arg pitch) -Y $(arg yaw)"/>
  
  <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false"
    output="screen" ns="/qcar" args="base_fr_controller base_fl_controller joint_state_controller"/>

  <!-- ================= VELOCITY EKF ================= -->
  <rosparam file="$(find qcar_visnav)/config/ekf.yaml" command="load"/>
  <node pkg="qcar_visnav" type="ekf_node" name="velocity_ekf" output="screen">
    <remap from="/joint_states" to="/qcar/joint_states"/>
  </node>
  <!-- ============================================== -->

  <!-- Motion test script for automatic driving -->
  <node pkg="qcar_visnav" type="simple_motion_test.py" name="motion_test" output="screen"/>

  <!-- Optional: RQT plot for real-time velocity visualization -->
  <!-- Uncomment to see live velocity plots -->
  <!-- <node pkg="rqt_plot" type="rqt_plot" name="velocity_plot" 
       args="/qcar/ekf/odom_body/twist/twist/linear/x /odom/twist/twist/linear/x" /> -->

</launch>