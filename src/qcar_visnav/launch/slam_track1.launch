<launch>
  <!-- Use simulated time -->
  <param name="use_sim_time" value="true"/>

  <!-- World + EKF + vehicle bring-up (your existing file) -->
  <include file="$(find qcar_visnav)/launch/Track1ExampleEKF.launch"/>

  <!-- Perception params -->
  <rosparam file="$(find qcar_visnav)/config/perception.yaml" command="load"/>

  <!-- Perception + tracker + their viz -->
  <node pkg="qcar_visnav" type="cone_detector_node" name="cone_detector" output="screen"/>
  <node pkg="qcar_visnav" type="cone_tracker_node"  name="cone_tracker"  output="screen"/>
  <node pkg="qcar_visnav" type="cones_viz_node"     name="cone_markers_raw"     output="screen"/>
  <node pkg="qcar_visnav" type="cones_viz_node"     name="cone_markers_tracked" output="screen"/>

  <!-- Identity TF so RViz can switch between map/odom if needed -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="map_to_odom"
        args="0 0 0 0 0 0 map odom"/>

  <!-- FastSLAM2 node -->
  <node pkg="qcar_visnav" type="fastslam2_node" name="fastslam2" output="screen">
    <param name="tracked_topic" value="/tracked_cones"/>
    <param name="odom_topic"    value="/ekf/odom"/>

    <param name="pub_particles" value="/slam/particles"/>
    <param name="pub_landmarks" value="/map_markers"/>

    <!-- Frames (we keep odom as the global for Block 5) -->
    <param name="map_frame"   value="map"/>
    <param name="odom_frame"  value="odom"/>
    <param name="base_frame"  value="base_footprint"/>
    <param name="lidar_frame" value="lidar"/>

    <!-- Tunables -->
    <param name="particles" value="120"/>
    <param name="resample_neff_ratio" value="0.6"/>
    <param name="chi2_gate" value="9.21"/>
    <param name="new_landmark_likelihood_min" value="0.25"/>
    <param name="meas_noise_xy_x" value="0.25"/>
    <param name="meas_noise_xy_y" value="0.25"/>
    <param name="odom_v_std" value="0.15"/>
    <param name="odom_yawrate_std" value="0.2"/>
    <param name="miss_in_fov_penalty" value="0.5"/>
    <param name="color_mismatch_penalty" value="0.7"/>
  </node>

  <!-- RViz pre-configured to subscribe to SLAM topics -->
  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find qcar_visnav)/rviz/viz_fastslam.rviz"/>
</launch>
