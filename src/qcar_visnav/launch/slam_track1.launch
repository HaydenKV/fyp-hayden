<launch>
  <!-- Use simulated time -->
  <param name="use_sim_time" value="true"/>

  <!-- World + EKF + vehicle bring-up -->
  <include file="$(find qcar_visnav)/launch/Track1ExampleEKF.launch"/>

  <!-- Perception params -->
  <rosparam file="$(find qcar_visnav)/config/perception.yaml" command="load"/>

  <!-- Perception + tracker + their viz -->
  <node pkg="qcar_visnav" type="cone_detector_node" name="cone_detector" output="screen"/>
  <node pkg="qcar_visnav" type="cone_tracker_node"  name="cone_tracker"  output="screen"/>
  <node pkg="qcar_visnav" type="cones_viz_node"     name="cone_markers_raw"     output="screen"/>
  <node pkg="qcar_visnav" type="cones_viz_node"     name="cone_markers_tracked" output="screen"/>

  <!-- FastSLAM2 node with DEBUG MODE enabled -->
  <node pkg="qcar_visnav" type="fastslam2_node" name="fastslam2" output="screen">
    <!-- Topics -->
    <param name="tracked_topic" value="/tracked_cones"/>
    <param name="odom_topic"    value="/ekf/odom"/>

    <!-- Publications -->
    <param name="pub_particles" value="/slam/particles"/>
    <param name="pub_landmarks" value="/map_markers"/>
    <param name="pub_weights"   value="/slam/weights"/>
    <param name="pub_slam_odom" value="/slam/odom"/>

    <!-- Frames -->
    <param name="map_frame"   value="map"/>
    <param name="odom_frame"  value="odom"/>
    <param name="base_frame"  value="base_footprint"/>
    <param name="lidar_frame" value="lidar"/>

    <!-- DEBUG MODE: Use ground truth for validation -->
    <param name="debug_use_ground_truth" value="true"/>

    <!-- Conservative parameters for debugging -->
    <param name="particles" value="50"/>  <!-- Fewer particles for easier debugging -->
    <param name="resample_neff_ratio" value="0.8"/>  <!-- Less frequent resampling -->
    <param name="chi2_gate" value="7.38"/>  <!-- Tighter gating (97.5% confidence) -->
    <param name="new_landmark_likelihood_min" value="0.3"/>  <!-- Conservative new landmark creation -->
    
    <!-- Reduced noise for ground truth validation -->
    <param name="meas_noise_xy_x" value="0.15"/>
    <param name="meas_noise_xy_y" value="0.15"/>
    <param name="odom_v_std" value="0.05"/>       <!-- Very low noise in debug mode -->
    <param name="odom_yawrate_std" value="0.02"/>
    
    <!-- Robustness penalties -->
    <param name="miss_in_fov_penalty" value="0.8"/>
    <param name="color_mismatch_penalty" value="0.9"/>

    <!-- LiDAR extrinsics - CRITICAL TO VERIFY! -->
    <param name="lidar_to_base_x" value="0.0"/>
    <param name="lidar_to_base_y" value="0.0"/>
    <param name="lidar_to_base_yaw_deg" value="0.0"/>
  </node>

  <!-- RViz with updated config -->
  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find qcar_visnav)/rviz/viz_fastslam.rviz"/>

</launch>