<launch>
  <!-- Define args with defaults -->
  <arg name="map_frame"  default="map"/>
  <arg name="odom_frame" default="odom"/>
  <arg name="base_frame" default="base_link"/>

  <!-- Load params from YAML -->
  <rosparam file="$(find qcar_visnav)/config/fastslam2.yaml" command="load"/>

  <!-- Start FastSLAM 2.0 stub node -->
  <node pkg="qcar_visnav" type="fastslam2_node" name="fastslam2" output="screen">
    <param name="map_frame"  value="$(arg map_frame)"/>
    <param name="odom_frame" value="$(arg odom_frame)"/>
    <param name="base_frame" value="$(arg base_frame)"/>
    <!-- Topics are taken from YAML; override here if desired -->
  </node>
</launch>
