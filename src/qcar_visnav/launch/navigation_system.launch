<launch>
    <!-- Complete Navigation System Launch -->
    
    <!-- Arguments -->
    <arg name="scenario" default="track1"/>
    <arg name="debug" default="true"/>
    <arg name="run_mapping" default="true"/>
    <arg name="run_estimator" default="true"/>
    <arg name="simulation_time" default="60.0"/>
    
    <!-- Robot initial pose -->
    <arg name="x" default="-4.3"/>
    <arg name="y" default="3"/>
    <arg name="z" default="0"/>
    <arg name="roll" default="0"/>
    <arg name="pitch" default="0"/>
    <arg name="yaw" default="-3.14"/>
    
    <!-- Load all configuration parameters -->
    <rosparam file="$(find qcar_visnav)/config/estimator_params.yaml" command="load"/>
    <rosparam file="$(find qcar_visnav)/config/mapping_params.yaml" command="load"/>
    <rosparam file="$(find qcar_controlplugin)/config/qcar_controlplugin.yaml" command="load"/>
    
    <!-- Override simulation time -->
    <param name="estimator_node/simulation_time" value="$(arg simulation_time)"/>
    <param name="estimator_node/publish_debug" value="$(arg debug)"/>
    
    <!-- URDF model -->
    <param name="robot_description" command="$(find xacro)/xacro $(find qcar_gazebo)/urdf/qcar_model.xacro" />
    
    <!-- Robot state publishers -->
    <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher"/>
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" output="screen">
        <remap from="/joint_states" to="/qcar/joint_states" />
    </node>
    
    <!-- Gazebo simulation -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(find qcar_gazebo)/worlds/Track1.world"/>
        <arg name="gui" value="true"/>
        <arg name="verbose" value="false"/>
        <arg name="paused" value="false"/>
    </include>
    
    <!-- Spawn QCar -->
    <node name="spawn_qcar" pkg="gazebo_ros" type="spawn_model" output="screen"
          args="-urdf -param robot_description -model qcar
                -x $(arg x) -y $(arg y) -z $(arg z)
                -R $(arg roll) -P $(arg pitch) -Y $(arg yaw)"/>
    
    <!-- Vehicle controllers -->
    <node name="controller_spawner" pkg="controller_manager" type="spawner" output="screen"
          ns="/qcar" args="base_fr_controller base_fl_controller joint_state_controller"/>
    
    <!-- Guidance and Control -->
    <node name="guidance_node" pkg="qcar_guidance" type="example_guidance_node.py" output="log"/>
    <node name="control_node" pkg="qcar_control" type="example_control_node" output="log"/>
    
    <!-- MAIN ESTIMATOR NODE (replaces multiple sensor nodes) -->
    <group if="$(arg run_estimator)">
        <node name="estimator_node" pkg="qcar_visnav" type="estimator_node" output="screen">
            <remap from="/qcar/imu" to="/qcar/imu"/>
            <remap from="/qcar/ground_truth/odom" to="/qcar/ground_truth/state"/>
            <remap from="/qcar/lidar" to="/qcar/2d_lidar"/>
        </node>
    </group>
    
    <!-- Occupancy Mapping Node (separate as per architecture) -->
    <group if="$(arg run_mapping)">
        <node name="mapping_node" pkg="qcar_visnav" type="mapping_node" output="screen">
            <remap from="/qcar_visnav/estimator_state" to="/qcar_visnav/estimator_state"/>
            <remap from="/qcar/lidar" to="/qcar/2d_lidar"/>
        </node>
    </group>
    
    <!-- Debug and visualization -->
    <group if="$(arg debug)">
        <!-- RViz for visualization -->
        <node name="rviz" pkg="rviz" type="rviz" args="-d $(find qcar_visnav)/config/navigation.rviz" output="screen"/>
        
        <!-- Event timing monitor -->
        <node name="event_monitor" pkg="qcar_visnav" type="event_monitor.py" output="screen"/>
    </group>
    
</launch>