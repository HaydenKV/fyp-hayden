<?xml version='1.0'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
   <gazebo reference="camera_csi_front">
        <sensor type="camera" name="front_camera">
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <camera name="front">
                <horizontal_fov>1.2043</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>1280</width>
                    <height>720</height>
                </image>
            </camera>
            <plugin name="camera_controller_front" filename="libgazebo_ros_camera.so">
                <cameraName>csi_front</cameraName>
                <frameName>csi_front_optical</frameName>
                <imageTopicName>image_raw</imageTopicName>
                <cameraInfoTopicName>camera_info</cameraInfoTopicName>
            </plugin>
        </sensor>
    </gazebo>

    <gazebo reference="camera_csi_right">
        <sensor type="camera" name="right_camera">
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <camera name="right">
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>1280</width>
                    <height>720</height>
                </image>
            </camera>
            <plugin name="camera_controller_right" filename="libgazebo_ros_camera.so">
                <cameraName>csi_right</cameraName>
                <frameName>csi_right_optical</frameName>
                <imageTopicName>image_raw</imageTopicName>
                <cameraInfoTopicName>camera_info</cameraInfoTopicName>
            </plugin>
        </sensor>
    </gazebo>

    <gazebo reference="camera_csi_left">
        <sensor type="camera" name="left_camera">
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <camera name="left">
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>1280</width>
                    <height>720</height>
                </image>
            </camera>
            <plugin name="camera_controller_left" filename="libgazebo_ros_camera.so">
                <cameraName>csi_left</cameraName>
                <frameName>csi_left_optical</frameName>
                <imageTopicName>image_raw</imageTopicName>
                <cameraInfoTopicName>camera_info</cameraInfoTopicName>
            </plugin>
        </sensor>
    </gazebo>

    <gazebo reference="camera_csi_back">
        <sensor type="camera" name="back_camera">
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <camera name="back">
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>1280</width>
                    <height>720</height>
                </image>
            </camera>
            <plugin name="camera_controller_back" filename="libgazebo_ros_camera.so">
                <cameraName>back_camera</cameraName>
            </plugin>
        </sensor>
    </gazebo>
    
    <!-- RGB stream for the RGB-D head (unchanged) -->
  <gazebo reference="camera_rgb">
    <sensor type="camera" name="rgbd_front_color">
      <visualize>true</visualize>
      <update_rate>15</update_rate>
      <camera name="rgbd_front_color_intrinsics">
        <horizontal_fov>1.211</horizontal_fov>
        <image>
          <format>R8G8B8</format>
          <width>1280</width>
          <height>720</height>
        </image>
      </camera>
      <plugin name="rgbd_color_controller" filename="libgazebo_ros_camera.so">
        <cameraName>rgbd_front</cameraName>
        <frameName>rgbd_front_optical</frameName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
      </plugin>
    </sensor>
  </gazebo>    
</robot>

